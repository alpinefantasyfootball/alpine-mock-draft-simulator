{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "draft-room",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "room",
      "runtimeExecutable": "npx",
