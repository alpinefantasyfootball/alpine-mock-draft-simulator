# Byte-compiled Python, created whenever the pipeline is imported
# rather than run. Nothing here belongs in the repo.
__pycache__/
*.pyc

# Local editor and assistant settings. Machine-specific, so they would only
# ever cause conflicts if they were shared.
.claude/

# The end-to-end test runner and what it leaves behind. The app itself has no
# dependencies and no build step — package.json exists only so `npm install`
# can fetch Playwright, and none of this is served, imported or needed to run
# the site. A checked-in node_modules would also be published, since Pages
# serves the whole repository.
node_modules/
test-results/
playwright-report/

# wrangler's local state: the Durable Object storage it fakes for
# `wrangler dev`, its bundle cache and its temp files. 18MB of machine-local
# scratch that is rebuilt on demand, and a checked-in copy would be someone
# else's half-finished draft.
worker/.wrangler/
